# Public Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Generate with: openssl rand -base64 32
SMTP_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Phase 3: encrypt user-supplied AI provider keys (generate a separate key with openssl rand -base64 32).
AI_KEY_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Set model IDs for every provider you want users to use. API keys are entered by users in Settings.
OPENAI_MODEL_ID=your-openai-structured-output-model
GROQ_MODEL_ID=openai/gpt-oss-20b
CLAUDE_MODEL_ID=your-claude-structured-output-model
GEMINI_MODEL_ID=your-gemini-structured-output-model

# Used in confirmation emails when the request origin is unavailable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
